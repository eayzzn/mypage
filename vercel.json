    { "source": "/giannabeauty", "destination": "https://giannabeauty-eayzzns-projects.vercel.app/giannabeauty" },
    { "source": "/giannabeauty/:path*", "destination": "https://giannabeauty-eayzzns-projects.vercel.app/giannabeauty/:path*" }
